{
  "name": "vscode-elena-lang",
  "displayName": "ELENA",
  "description": "ELENA Language support for Visual Studio Code",
  "icon": "icons/icon.png",
  "version": "0.0.2",
  "publisher": "ELENA-LANG",
  "engines": {
    "vscode": "^1.91.0"
  },
  "bugs": {
    "url": "https://github.com/ELENA-LANG/vscode-elena-lang/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ELENA-LANG/vscode-elena-lang"
  },
  "keywords": [
    "elena-lang",
    "ELENA"
  ],
  "categories": [
    "Programming Languages"
  ],
  "l10n": "./l10n",
  "contributes": {
    "languages": [
      {
        "id": "elena",
        "aliases": [
          "ELENA",
          "elena"
        ],
        "extensions": [
          "l",
          "prj"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "elena",
        "scopeName": "source.elena-lang",
        "path": "./syntaxes/elena.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "ELENA",
      "properties": {
        "elena.executablePath": {
          "scope": "resource",
          "type": "string",
          "description": "Custom path to ELENA compiler executable (`elena-cli`)."
        }
      }
    },
    "commands": [
      {
        "command": "elena.BuildAndDebugFile",
        "title": "Debug ELENA File",
        "category": "ELENA",
        "icon": "$(debug-alt)"
      },
      {
        "command": "elena.BuildAndRunFile",
        "title": "Run ELENA File",
        "category": "ELENA",
        "icon": "$(run)"
      }
    ],
    "debuggers": [
      {
        "type": "ldbg",
        "languages": [
          "elena"
        ],
        "label": "ELENA Debugger",
        "windows": {
          "program": "C:/Alex/elena-lang/bin/elena-dpa.exe"
        },
        "configurationAttributes": {
          "launch": {
            "required": ["program"],
            "properties": {
              "program": {
                "type": "string",
                "description": "Absolute path to the program",
                "default": "${workspaceFolder}/sandbox.exe"
              }
            }
          } 
        },
        "initialConfigurations": [
          {
            "type": "ldbg",
            "request": "launch",
            "name": "ldbg Launch",
            "program": "${workspaceFolder}/sandbox.exe"
          }
        ],
        "configurationSnippets": [
          {
            "label": "ldbg: Launch",
            "description": "A new configuration for launching ELENA debug program",
            "body": {
              "type": "ldbg",
              "request": "launch",
              "name": "${2:Launch Program}",
              "program": "^\"\\${workspaceFolder}/${1:Program}\""
            }
          }
        ]
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "elena.BuildAndDebugFile",
          "when": "editorLangId == elena",
          "group": "navigation@0"
        },
        {
          "command": "elena.BuildAndRunFile",
          "when": "editorLangId == elena",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "elena.BuildAndDebugFile",
          "when": "editorLangId == elena"
        },
        {
          "command": "elena.BuildAndRunFile",
          "when": "editorLangId == elena"
        }
      ] 
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "activationEvents": [
    "workspaceContains:**/*.l",
    "onLanguage:elena",
    "onDebugResolve:ldbg",
    "onDebugDynamicConfigurations:ldbg"
  ],
  "main": "./dist/main.js",
  "devDependencies": {
    "@types/vscode": "^1.91.0",
    "@types/mocha": "^10.0.7",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser": "^7.11.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.5",
    "@vscode/test-cli": "^0.0.9",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/debugadapter": "^1.61.0",
    "@vscode/debugprotocol": "^1.61.0"
  }
}
